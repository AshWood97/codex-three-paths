{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-native-orchestrator/plan.schema.json",
  "type": "object",
  "required": ["schema_version", "plan_id", "objective", "gate_mode", "hard_risk", "tasks", "max_concurrency"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "objective": {"type": "string", "minLength": 1},
    "gate_mode": {"enum": ["pre", "final", "none"]},
    "hard_risk": {"type": "boolean"},
    "read_only": {"type": "boolean"},
    "route": {"const": "hybrid"},
    "overrides": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owned_paths": {"type": "array", "items": {"type": "string"}},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 4},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "role", "objective", "depends_on", "scope", "non_goals", "owned_paths", "acceptance_criteria", "write_mode", "context_refs", "timeout", "retry_policy", "prompt", "read_only", "writes"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "role": {"enum": ["explorer", "worker", "tester", "researcher", "reviewer"]},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "objective": {"type": "string", "minLength": 1},
          "scope": {"type": "array"},
          "non_goals": {"type": "array"},
          "owned_paths": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array"},
          "write_mode": {"enum": ["read-only", "workspace-write"]},
          "context_refs": {"type": "array"},
          "timeout": {"type": "number", "exclusiveMinimum": 0},
          "retry_policy": {
            "type": "object",
            "required": ["max_attempts"],
            "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 2}},
            "additionalProperties": true
          },
          "prompt": {"type": "string", "minLength": 1},
          "read_only": {"type": "boolean"},
          "writes": {"type": "boolean"}
        }
      }
    }
  }
}
